[node name="BreakwaterMission" type="Node3D"]
script = ExtResource("level")
level_name = "Breakwater Station — Black Start"
level_author = "MODUS"
level_description = "Restart the coastal station through the pump hall, intake, turbine and relay, then ride the powered lift home."
level_tags = Array[String](["breakwater", "mission", "industrial"])
metadata/mission_id = "breakwater_station"
module_connections = Array[Dictionary]([{"from_instance": "dock", "from_socket": "out", "to_instance": "hub", "to_socket": "in"}, {"from_instance": "hub", "from_socket": "pump", "to_instance": "pump", "to_socket": "in"}, {"from_instance": "pump", "from_socket": "out", "to_instance": "intake", "to_socket": "in"}, {"from_instance": "intake", "from_socket": "out", "to_instance": "turbine", "to_socket": "in"}, {"from_instance": "intake", "from_socket": "cavern", "to_instance": "cavern", "to_socket": "intake"}, {"from_instance": "cavern", "from_socket": "turbine", "to_instance": "turbine", "to_socket": "cavern"}, {"from_instance": "turbine", "from_socket": "out", "to_instance": "relay", "to_socket": "in"}, {"from_instance": "relay", "from_socket": "return", "to_instance": "return_landing", "to_socket": "relay"}, {"from_instance": "return_landing", "from_socket": "lift", "to_instance": "return", "to_socket": "in"}, {"from_instance": "return", "from_socket": "out", "to_instance": "return_gallery", "to_socket": "lift"}, {"from_instance": "return_gallery", "from_socket": "hub", "to_instance": "return_elbow", "to_socket": "gallery"}, {"from_instance": "return_elbow", "from_socket": "hub", "to_instance": "hub", "to_socket": "return"}])
